generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SiteStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")

  @@map("site_status")
}

enum SourceType {
  WEBSITE        @map("website")
  RSS            @map("rss")
  NEWS_API       @map("news_api")
  SEARCH_CONSOLE @map("search_console")
  MANUAL         @map("manual")

  @@map("source_type")
}

enum CollectionMethod {
  API    @map("api")
  RSS    @map("rss")
  CRAWL  @map("crawl")
  MANUAL @map("manual")

  @@map("collection_method")
}

enum TrustLevel {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")

  @@map("trust_level")
}

enum CollectionFrequency {
  MANUAL  @map("manual")
  HOURLY  @map("hourly")
  DAILY   @map("daily")
  WEEKLY  @map("weekly")
  MONTHLY @map("monthly")

  @@map("collection_frequency")
}

enum TopicStatus {
  CANDIDATE               @map("candidate")
  REVIEWING               @map("reviewing")
  APPROVED                @map("approved")
  RESEARCHING             @map("researching")
  BRIEF_READY             @map("brief_ready")
  DRAFTING                @map("drafting")
  QUALITY_REVIEW          @map("quality_review")
  AWAITING_APPROVAL       @map("awaiting_approval")
  APPROVED_FOR_PUBLISHING @map("approved_for_publishing")
  PUBLISHED               @map("published")
  REJECTED                @map("rejected")
  FAILED                  @map("failed")

  @@map("topic_status")
}

enum TopicPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")

  @@map("topic_priority")
}

enum EvidenceType {
  MANUAL      @map("manual")
  SOURCE      @map("source")
  TREND       @map("trend")
  KEYWORD     @map("keyword")
  COMPETITOR  @map("competitor")
  PERFORMANCE @map("performance")

  @@map("evidence_type")
}

enum RssCollectionStatus {
  STARTED      @map("started")
  SUCCEEDED    @map("succeeded")
  PARTIAL      @map("partial")
  FAILED       @map("failed")
  NOT_MODIFIED @map("not_modified")

  @@map("rss_collection_status")
}

enum ResearchJobStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  PARTIAL   @map("partial")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("research_job_status")
}

enum ResearchTriggerType {
  MANUAL      @map("manual")
  INTERNAL_API @map("internal_api")
  N8N         @map("n8n")

  @@map("research_trigger_type")
}

enum ResearchMode {
  DETERMINISTIC @map("deterministic")
  OPENAI        @map("openai")

  @@map("research_mode")
}

enum ResearchSourceStatus {
  SELECTED   @map("selected")
  PROCESSING @map("processing")
  SUCCEEDED  @map("succeeded")
  SKIPPED    @map("skipped")
  FAILED     @map("failed")

  @@map("research_source_status")
}

enum ResearchNoteType {
  SOURCE_SUMMARY @map("source_summary")

  @@map("research_note_type")
}

enum AiUsageStatus {
  STARTED   @map("started")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("ai_usage_status")
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  auditLogs AuditLog[]

  @@map("users")
}

model Site {
  id             String         @id @default(cuid())
  name           String
  domain         String         @unique
  niche          String?
  language       String         @default("en")
  targetAudience String?        @map("target_audience")
  status         SiteStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  sourceConfigs  SourceConfig[]
  topics         Topic[]
  researchJobs   ResearchJob[]
  researchNotes  ResearchNote[]

  @@index([status])
  @@map("sites")
}

model SourceConfig {
  id                        String              @id @default(cuid())
  siteId                    String              @map("site_id")
  name                      String
  sourceType                SourceType          @map("source_type")
  baseUrl                   String?             @map("base_url")
  collectionMethod          CollectionMethod    @map("collection_method")
  trustLevel                TrustLevel          @default(MEDIUM) @map("trust_level")
  collectionFrequency       CollectionFrequency @default(MANUAL) @map("collection_frequency")
  isActive                  Boolean             @default(true) @map("is_active")
  collectionLimit           Int?                @map("collection_limit")
  lastCollectedAt           DateTime?           @map("last_collected_at")
  lastSuccessfulCollectedAt DateTime?           @map("last_successful_collected_at")
  lastErrorAt               DateTime?           @map("last_error_at")
  lastErrorSummary          String?              @map("last_error_summary")
  httpEtag                  String?              @map("http_etag")
  httpLastModified          String?              @map("http_last_modified")
  metadata                  Json?
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  site                      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  evidence                  TopicEvidence[]
  rssCollectionRuns         RssCollectionRun[]
  researchJobSources        ResearchJobSource[]

  @@unique([siteId, name])
  @@index([siteId, isActive])
  @@index([isActive, lastCollectedAt])
  @@map("source_configs")
}

model RssCollectionRun {
  id                  String              @id @default(cuid())
  sourceConfigId      String              @map("source_config_id")
  workflowExecutionId String?             @map("workflow_execution_id")
  status              RssCollectionStatus
  startedAt           DateTime            @map("started_at")
  completedAt         DateTime?           @map("completed_at")
  discoveredCount     Int                 @default(0) @map("discovered_count")
  returnedCount       Int                 @default(0) @map("returned_count")
  submittedCount      Int                 @default(0) @map("submitted_count")
  acceptedCount       Int                 @default(0) @map("accepted_count")
  matchedCount        Int                 @default(0) @map("matched_count")
  skippedCount        Int                 @default(0) @map("skipped_count")
  failedCount         Int                 @default(0) @map("failed_count")
  httpStatus          Int?                @map("http_status")
  etag                String?
  lastModified        String?             @map("last_modified")
  errorCode           String?             @map("error_code")
  errorSummary        String?             @map("error_summary")
  durationMs          Int?                @map("duration_ms")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  sourceConfig        SourceConfig        @relation(fields: [sourceConfigId], references: [id], onDelete: Cascade)

  @@index([sourceConfigId, startedAt])
  @@index([status, startedAt])
  @@map("rss_collection_runs")
}

model Topic {
  id              String          @id @default(cuid())
  siteId          String          @map("site_id")
  title           String
  normalizedTitle String          @map("normalized_title")
  description     String?
  intakeOrigin    String?         @map("intake_origin")
  intakeMetadata  Json?           @map("intake_metadata")
  status          TopicStatus     @default(CANDIDATE)
  priority        TopicPriority   @default(MEDIUM)
  totalScore      Int             @default(0) @map("total_score")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  evidence        TopicEvidence[]
  scores          TopicScore[]
  researchJobs    ResearchJob[]
  researchNotes   ResearchNote[]

  @@unique([siteId, normalizedTitle])
  @@index([siteId, status, priority])
  @@index([siteId, totalScore])
  @@map("topics")
}

model TopicEvidence {
  id                  String        @id @default(cuid())
  topicId             String        @map("topic_id")
  sourceConfigId      String?       @map("source_config_id")
  evidenceType        EvidenceType  @map("evidence_type")
  sourceUrl           String        @map("source_url")
  sourceTitle         String?       @map("source_title")
  excerpt             String?
  externalId          String?       @map("external_id")
  evidenceFingerprint String?       @map("evidence_fingerprint")
  collectedAt         DateTime      @map("collected_at")
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  topic               Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceConfig        SourceConfig? @relation(fields: [sourceConfigId], references: [id], onDelete: SetNull)
  researchJobSources  ResearchJobSource[]
  researchNotes       ResearchNote[]

  @@unique([topicId, sourceUrl, evidenceType])
  @@unique([topicId, evidenceFingerprint])
  @@index([topicId, collectedAt])
  @@index([sourceConfigId])
  @@index([sourceConfigId, externalId])
  @@map("topic_evidence")
}

model TopicScore {
  id                    String   @id @default(cuid())
  topicId               String   @map("topic_id")
  audienceRelevance     Int      @map("audience_relevance")
  evidenceStrength      Int      @map("evidence_strength")
  businessValue         Int      @map("business_value")
  contentGap            Int      @map("content_gap")
  freshness             Int
  sourceReliability     Int      @map("source_reliability")
  productionFeasibility Int      @map("production_feasibility")
  total                 Int
  rationale             String?
  createdAt             DateTime @default(now()) @map("created_at")
  topic                 Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  @@map("topic_scores")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  dedupeKey     String?  @unique @map("dedupe_key")
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model IntakeIdempotencyRecord {
  id             String   @id @default(cuid())
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  topicId        String?  @map("topic_id")
  evidenceId     String?  @map("evidence_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([createdAt])
  @@map("intake_idempotency_records")
}

model InternalApiRateLimitBucket {
  id             String   @id @default(cuid())
  scope          String
  identifierHash String   @map("identifier_hash")
  windowStart    DateTime @map("window_start")
  requestCount   Int      @default(1) @map("request_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([scope, identifierHash, windowStart])
  @@index([windowStart])
  @@map("internal_api_rate_limit_buckets")
}

model ResearchJob {
  id                         String              @id @default(cuid())
  siteId                     String              @map("site_id")
  topicId                    String              @map("topic_id")
  activeTopicId              String?             @unique @map("active_topic_id")
  status                     ResearchJobStatus   @default(QUEUED)
  triggerType                ResearchTriggerType @map("trigger_type")
  mode                       ResearchMode
  deterministicFallbackUsed Boolean             @default(false) @map("deterministic_fallback_used")
  startedAt                  DateTime?           @map("started_at")
  completedAt                DateTime?           @map("completed_at")
  failedAt                   DateTime?           @map("failed_at")
  selectedEvidenceCount      Int                 @default(0) @map("selected_evidence_count")
  fetchedSourceCount         Int                 @default(0) @map("fetched_source_count")
  successfulSourceCount      Int                 @default(0) @map("successful_source_count")
  skippedSourceCount         Int                 @default(0) @map("skipped_source_count")
  failedSourceCount          Int                 @default(0) @map("failed_source_count")
  generatedNoteCount         Int                 @default(0) @map("generated_note_count")
  errorCode                  String?             @map("error_code")
  errorSummary               String?             @map("error_summary")
  workflowExecutionReference String?             @map("workflow_execution_reference")
  metadata                   Json?
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  site                       Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic                      Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sources                    ResearchJobSource[]
  notes                      ResearchNote[]
  aiUsage                    AiUsage[]

  @@index([siteId, status, createdAt])
  @@index([topicId, createdAt])
  @@map("research_jobs")
}

model ResearchJobSource {
  id                  String               @id @default(cuid())
  researchJobId       String               @map("research_job_id")
  evidenceId          String?              @map("evidence_id")
  sourceConfigId      String?              @map("source_config_id")
  sourceUrl           String               @map("source_url")
  canonicalUrl        String               @map("canonical_url")
  sourceTitle         String?              @map("source_title")
  selectionRank       Int                  @map("selection_rank")
  status              ResearchSourceStatus @default(SELECTED)
  attemptCount        Int                  @default(0) @map("attempt_count")
  fetchedAt           DateTime?            @map("fetched_at")
  contentType         String?              @map("content_type")
  contentFingerprint  String?              @map("content_fingerprint")
  errorCode           String?              @map("error_code")
  errorSummary        String?              @map("error_summary")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  researchJob         ResearchJob          @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  evidence            TopicEvidence?       @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  sourceConfig        SourceConfig?        @relation(fields: [sourceConfigId], references: [id], onDelete: SetNull)
  notes               ResearchNote[]
  aiUsage             AiUsage[]

  @@unique([researchJobId, canonicalUrl])
  @@index([researchJobId, status, selectionRank])
  @@index([evidenceId])
  @@map("research_job_sources")
}

model ResearchNote {
  id                  String           @id @default(cuid())
  researchJobId       String           @map("research_job_id")
  researchJobSourceId String           @map("research_job_source_id")
  topicId             String           @map("topic_id")
  siteId              String           @map("site_id")
  evidenceId          String?          @map("evidence_id")
  noteType            ResearchNoteType @default(SOURCE_SUMMARY) @map("note_type")
  mode                ResearchMode
  version             Int              @default(1)
  title               String
  summary             String
  claims              Json
  definitions         Json
  statistics          Json
  examples            Json
  risks               Json
  openQuestions       Json             @map("open_questions")
  excerpts            Json
  sourceUrl           String           @map("source_url")
  sourceTitle         String           @map("source_title")
  sourcePublisher     String?          @map("source_publisher")
  author              String?
  publishedAt         DateTime?        @map("published_at")
  fetchedAt           DateTime         @map("fetched_at")
  contentFingerprint  String           @map("content_fingerprint")
  qualityFlags        Json?            @map("quality_flags")
  metadata            Json?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  researchJob         ResearchJob      @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  researchJobSource   ResearchJobSource @relation(fields: [researchJobSourceId], references: [id], onDelete: Cascade)
  topic               Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  site                Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  evidence            TopicEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  aiUsage             AiUsage[]

  @@unique([researchJobSourceId, contentFingerprint])
  @@index([topicId, createdAt])
  @@index([researchJobId, createdAt])
  @@map("research_notes")
}

model AiUsage {
  id                  String        @id @default(cuid())
  researchJobId       String        @map("research_job_id")
  researchJobSourceId String        @map("research_job_source_id")
  researchNoteId      String?       @map("research_note_id")
  requestKey          String        @unique @map("request_key")
  provider            String
  model               String
  inputTokens         Int?          @map("input_tokens")
  outputTokens        Int?          @map("output_tokens")
  estimatedCostUsd    Decimal?      @db.Decimal(12, 6) @map("estimated_cost_usd")
  requestDurationMs   Int           @map("request_duration_ms")
  status              AiUsageStatus
  errorCode           String?       @map("error_code")
  promptTemplateVersion String      @map("prompt_template_version")
  createdAt           DateTime      @default(now()) @map("created_at")
  researchJob         ResearchJob   @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  researchJobSource   ResearchJobSource @relation(fields: [researchJobSourceId], references: [id], onDelete: Cascade)
  researchNote        ResearchNote? @relation(fields: [researchNoteId], references: [id], onDelete: SetNull)

  @@index([researchJobId, createdAt])
  @@map("ai_usage")
}
