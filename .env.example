# Auth.js / NextAuth.js
NEXTAUTH_URL=http://localhost:3000
# Generate a unique value with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters-long

# PostgreSQL
POSTGRES_USER=publishing_os
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=publishing_os
POSTGRES_PORT=5433
DATABASE_URL=postgresql://publishing_os:replace-with-a-local-database-password@localhost:5433/publishing_os?schema=public
TEST_DATABASE_URL=postgresql://publishing_os:replace-with-a-local-database-password@localhost:5433/publishing_os_test?schema=public

# Server operations
# Generate a unique value with: openssl rand -base64 32
INTERNAL_API_KEY=replace-with-a-unique-internal-api-key-at-least-32-characters
LOG_LEVEL=info

# DEVELOPMENT LOGIN ONLY.
# These values are read only when Next.js runs with NODE_ENV=development.
# This credentials login is intentionally unavailable in production.
DEV_AUTH_EMAIL=developer@example.com
DEV_AUTH_PASSWORD=replace-with-a-long-development-only-password
DEV_AUTH_NAME=Local Developer
