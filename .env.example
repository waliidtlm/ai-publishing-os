# Auth.js / NextAuth.js
NEXTAUTH_URL=http://localhost:3000
# Generate a unique value with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters-long

# PostgreSQL
POSTGRES_USER=publishing_os
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=publishing_os
POSTGRES_PORT=5433
DATABASE_URL=postgresql://publishing_os:replace-with-a-local-database-password@localhost:5433/publishing_os?schema=public
TEST_DATABASE_URL=postgresql://publishing_os:replace-with-a-local-database-password@localhost:5433/publishing_os_test?schema=public

# Server operations
# Generate a unique value with: openssl rand -base64 32
INTERNAL_API_KEY=replace-with-a-unique-internal-api-key-at-least-32-characters
INTERNAL_API_RATE_LIMIT_MAX=60
INTERNAL_API_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Application-side RSS fetch controls
RSS_MAX_SOURCES_PER_RUN=25
RSS_MAX_ENTRIES_PER_SOURCE=20
RSS_REQUEST_TIMEOUT_MS=10000
RSS_MAX_RESPONSE_BYTES=1048576
RSS_MAX_REDIRECTS=3

# Research engine
# Deterministic mode is explicit and costs nothing. Set RESEARCH_AI_ENABLED=true
# and provide AI_API_KEY to use the OpenAI adapter.
RESEARCH_DEFAULT_MODE=deterministic
RESEARCH_AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL_RESEARCH=gpt-5-mini
AI_API_KEY=
RESEARCH_ALLOW_DETERMINISTIC_FALLBACK=false
RESEARCH_MAX_SOURCES_PER_JOB=10
RESEARCH_MAX_NOTES_PER_JOB=5
RESEARCH_REQUEST_TIMEOUT_MS=15000
RESEARCH_MAX_RESPONSE_BYTES=2097152
RESEARCH_MAX_REDIRECTS=3
RESEARCH_MAX_INPUT_CHARS=100000
RESEARCH_MAX_OUTPUT_TOKENS=2500
RESEARCH_MAX_CLAIMS_PER_SOURCE=10
RESEARCH_MAX_EXCERPT_CHARS=500
RESEARCH_MAX_CONCURRENT_FETCHES=2
RESEARCH_MAX_CONCURRENT_AI_PER_SITE=1

# Content brief generator
# OpenAI mode is server-only and never falls back unless explicitly enabled.
CONTENT_BRIEF_DEFAULT_MODE=deterministic
CONTENT_BRIEF_AI_ENABLED=false
AI_MODEL_CONTENT_BRIEF=gpt-5-mini
CONTENT_BRIEF_ALLOW_DETERMINISTIC_FALLBACK=false
CONTENT_BRIEF_MAX_NOTES=20
CONTENT_BRIEF_MAX_CLAIMS=50
CONTENT_BRIEF_MAX_SOURCES=20
CONTENT_BRIEF_MAX_PROMPT_CHARS=120000
CONTENT_BRIEF_MAX_OUTLINE_SECTIONS=12
CONTENT_BRIEF_MAX_OUTPUT_TOKENS=4000
CONTENT_BRIEF_MAX_GENERATIONS_PER_HOUR=10
CONTENT_BRIEF_MAX_GENERATIONS_PER_TOPIC_PER_HOUR=3
CONTENT_BRIEF_MAX_CONCURRENT_AI_PER_SITE=1

# n8n only: URL that the n8n container or host can use to reach the dashboard.
AI_PUBLISHING_OS_BASE_URL=http://localhost:3000
RESEARCH_TOPIC_ID=
RESEARCH_MODE=deterministic
CONTENT_BRIEF_TOPIC_ID=
CONTENT_BRIEF_MODE=deterministic

# DEVELOPMENT LOGIN ONLY.
# These values are read only when Next.js runs with NODE_ENV=development.
# This credentials login is intentionally unavailable in production.
DEV_AUTH_EMAIL=developer@example.com
DEV_AUTH_PASSWORD=replace-with-a-long-development-only-password
DEV_AUTH_NAME=Local Developer
