    {
      "id": "462868f7-236e-4c1a-a025-471d4da91649",
      "name": "Normalize Intake Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4160, 40],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const work = $json.work;\nconst success = [200, 201].includes($json.statusCode) && $json.body?.success === true;\nreturn { json: { source: work.source, runId: work.runId, startedAt: work.startedAt, fetch: work.fetch, kind: 'intake_result', intakeSuccess: success, matched: success && $json.body.data?.matchedExistingTopic === true, errorSummary: success ? null : ($json.body?.error?.message ?? 'Topic Intake failed.'), intakeStatus: $json.statusCode } };"
      }
